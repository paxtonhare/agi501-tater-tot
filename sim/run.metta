!(import! &self ../.deps/MetaMo/core/helper)
!(import! &self "../.deps/MetaMo/core/helpers.py")
!(import! &self ../.deps/MetaMo/core/state)
!(import! &self ../.deps/MetaMo/core/state_accessors)
!(import! &self ../.deps/MetaMo/core/config)
!(import! &self ../.deps/MetaMo/openpsi/config)
!(import! &self ../.deps/MetaMo/category/functors)
!(import! &self ../.deps/MetaMo/category/bimonad)
!(import! &self ../.deps/MetaMo/openpsi/appraisal)
!(import! &self ../.deps/MetaMo/openpsi/appraisal_helpers)
!(import! &self ../.deps/MetaMo/magus/decision)
!(import! &self ../.deps/MetaMo/dynamics/stability)
!(import! &self ../.deps/MetaMo/dynamics/coherence)
!(import! &self ../.deps/MetaMo/main/main)
!(import! &self house)
!(import! &self body)
!(import! &self cat)
!(import! &self adapter)

(= (catLoop $step $limit $mode $states ($room $oldHuman $drives $toys $oldGlass $active $work $rng $afterMeal))
    (if (> $step $limit)
        (println! (CAT-DONE $limit))
        (let* (($nextRng (nextRandom $rng))
               ($human (humanRoom $step $nextRng $oldHuman))
               ;; Offscreen cleanup: return the glass every 12 ticks.
               ($glass (if (== (% $step 12) 0) table $oldGlass))
               ($levels (rise $drives $afterMeal))
               ($stimulus (catStimulus $room $human $oldHuman $levels $toys $glass))
               ($candidates (catCandidates $room $human $levels $toys $glass))
               ($result (chooseCat $states $stimulus $candidates $mode $active $work))
               ($task (actionId (cycleFinalAction $result)))
               (($newRoom ($nh $nc $na $nm $nt $nl) $newToys $newGlass $nextTask $nextWork $action)
                 (act $task $room $human $levels $toys $glass $active $work))
               ($nextClock (mealClock $action $nextWork $afterMeal))
               ($_ (println! (CAT $step $newRoom $human $nh $nc $na $nm $nt $nl $action (taskGoal $task)
                                  $task $active $work $nextWork $newGlass))))
            (catLoop (+ $step 1) $limit $mode (cycleNextStates $result)
                     ($newRoom $human ($nh $nc $na $nm $nt $nl) $newToys $newGlass
                      $nextTask $nextWork $nextRng $nextClock)))))

(= (startCat $seed $steps $mode)
    (catLoop 1 $steps $mode (catStates)
             (hallway hallway (25 25 25 25 0 0) (100 100 100) table none 0 $seed 0)))
