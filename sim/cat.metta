;; Drives are 0..100; toy interest rises when not played with.
(= (rise ($h $c $a $m))
    ((min 100 (+ $h 7)) (min 100 (+ $c 6)) (min 100 (+ $a 5)) (min 100 (+ $m 4))))
(= (recoverInterest $used $toy $interest)
    (if (== $used $toy) (max 0 (- $interest 25)) (min 100 (+ $interest 4))))
(= (updateToys ($zip $box $mouse) $used)
    ((recoverInterest $used zip-tie $zip) (recoverInterest $used cardboard-box $box)
     (recoverInterest $used catnip-mouse $mouse)))

;; These are task IDs; active goal is the drive that task serves.
(= (taskGoal eat) hunger)
(= (taskGoal zip-tie) curiosity)
(= (taskGoal cardboard-box) curiosity)
(= (taskGoal catnip-mouse) curiosity)
(= (taskGoal cuddle) affection)
(= (taskGoal knock) mischief)
(= (taskRoom eat $_) (match &self (place food-bowl $room) $room))
(= (taskRoom cuddle $human) $human)
(= (taskRoom knock $_)
    (let $table (match &self (place glass $table) $table) (match &self (place $table $room) $room)))
(= (toyRoom $toy) (match &self (place $toy $room) $room))
(= (taskRoom zip-tie $_) (toyRoom zip-tie))
(= (taskRoom cardboard-box $_) (toyRoom cardboard-box))
(= (taskRoom catnip-mouse $_) (toyRoom catnip-mouse))

(= (duration eat) 3)
(= (duration zip-tie) 3)
(= (duration cardboard-box) 3)
(= (duration catnip-mouse) 3)
(= (duration cuddle) 2)
(= (duration knock) 1)
(= (relieve hunger ($h $c $a $m)) ((max 0 (- $h 63)) $c $a $m))
(= (relieve curiosity ($h $c $a $m)) ($h (max 0 (- $c 63)) $a $m))
(= (relieve affection ($h $c $a $m)) ($h $c (max 0 (- $a 63)) $m))
(= (relieve mischief ($h $c $a $m)) ($h $c $a (max 0 (- $m 63))))

;; Only in-room work counts toward completion. Switching task restarts work.
;; Returns room, drives, toys, glass, open task, work count, physical action.
(= (act $task $room $human $drives $toys $glass $active $work)
    (let* (($target (taskRoom $task $human)) ($prior (if (== $task $active) $work 0)))
        (if (== $room $target)
            (let* (($n (+ $prior 1)) ($done (== $n (duration $task)))
                   ($levels (if $done (relieve (taskGoal $task) $drives) $drives))
                   ($verb (if (== $task knock) (if (== $human $room) knock-scolded knock) $task)))
                ($room $levels (updateToys $toys $task) (if (== $task knock) floor $glass)
                 (if $done none $task) (if $done 0 $n) $verb))
            ((nextRoom $room $target) $drives (updateToys $toys none) $glass $task $prior move))))
